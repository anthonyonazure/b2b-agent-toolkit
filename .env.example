# Toggle: when true, all adapters except portal-client return canned data
B2B_USE_MOCKS=true

# Microsoft 365 (Graph) — app-only auth via certificate or client secret
B2B_M365_TENANT_ID=
B2B_M365_CLIENT_ID=
B2B_M365_CLIENT_SECRET=

# HubSpot Private App
B2B_HUBSPOT_TOKEN=

# Zendesk
B2B_ZENDESK_SUBDOMAIN=
B2B_ZENDESK_EMAIL=
B2B_ZENDESK_TOKEN=

# Internal portal (defaults to local mock server)
B2B_PORTAL_BASE_URL=http://localhost:8001
B2B_PORTAL_API_KEY=mock-key
